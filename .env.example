# ---------------------------------------------------------------------------
# Codivra Solutions — environment contract
# Copy to `.env` and fill. Every variable below is validated at boot by
# src/lib/env.ts; the app refuses to start with a malformed value.
# ---------------------------------------------------------------------------

# --- Database (Neon / Supabase Postgres) -----------------------------------
# DATABASE_URL goes through the pooler (PgBouncer) and is what the app uses.
# DIRECT_URL bypasses the pooler and is what `prisma migrate` uses — DDL and
# advisory locks do not survive a transaction pooler.
#
# On Neon the two differ only by the `-pooler` suffix on the host:
#   pooled: ep-xxxx-pooler.region.aws.neon.tech
#   direct: ep-xxxx.region.aws.neon.tech
#
# Use sslmode=verify-full, not sslmode=require. node-postgres v8.16+ changed
# what `require` means and logs a deprecation warning; Neon and Supabase both
# present valid public certificates, so verify-full is stricter AND quieter.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require"
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require"

# --- Site ------------------------------------------------------------------
# No trailing slash. Drives canonicals, sitemap, JSON-LD @id values and llms.txt.
NEXT_PUBLIC_SITE_URL="https://www.codivra.com"
NEXT_PUBLIC_TRAINING_URL="https://www.codivratraining.com"

# --- Auth (NextAuth v5) ----------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Seed credentials for the first ADMIN user. Used only by `pnpm db:seed`.
SEED_ADMIN_EMAIL="yash@codivrasolutions.com"
SEED_ADMIN_PASSWORD=""

# --- Cloudinary ------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Must equal CLOUDINARY_CLOUD_NAME. Needed client-side by the upload widget.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
# Unsigned upload preset used by the admin media widget.
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="codivra_admin"

# --- Email (SMTP via nodemailer) -------------------------------------------
# Leave SMTP_HOST empty in development: mail is logged to the console instead
# of sent, so the contact form works without a mail server.
#
# Port 587 uses STARTTLS (SMTP_SECURE=false); port 465 uses implicit TLS
# (SMTP_SECURE=true). Getting this pair wrong is the usual cause of a hang.
#
# Gmail/Workspace: smtp.gmail.com:587, and SMTP_PASSWORD must be a 16-character
# App Password, not the account password.
# Zoho: smtp.zoho.in:465 with SMTP_SECURE=true.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""

# Envelope sender. Must be a domain you are authorised to send as, with SPF
# and DKIM configured, or mail lands in spam.
MAIL_FROM="Codivra Solutions <no-reply@codivrasolutions.com>"

# Where new enquiry notifications land.
SALES_NOTIFICATION_EMAIL="info@codivrasolutions.com"

# --- Rate limiting (Upstash Redis) -----------------------------------------
# Optional in development: if unset, the app falls back to an in-memory
# token bucket. Required in production — the app refuses to build without it.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- reCAPTCHA v3 ----------------------------------------------------------
RECAPTCHA_SECRET_KEY=""
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
# Below this score a submission is stored with status=SPAM instead of NEW.
RECAPTCHA_MIN_SCORE="0.5"

# --- Analytics -------------------------------------------------------------
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"
NEXT_PUBLIC_CLARITY_ID=""

# --- Contact details (surfaced in UI, JSON-LD and llms.txt) ----------------
NEXT_PUBLIC_PHONE="+919793370700"
NEXT_PUBLIC_WHATSAPP="919793370700"
NEXT_PUBLIC_EMAIL="info@codivrasolutions.com"

# --- Search Console / verification ----------------------------------------
GOOGLE_SITE_VERIFICATION=""
BING_SITE_VERIFICATION=""

# --- Google Business Profile ----------------------------------------------
# Leave empty until the listing is live. When empty it is omitted from the
# Organization `sameAs` array rather than emitted as a dead URL.
NEXT_PUBLIC_GBP_URL=""

# --- Draft preview ---------------------------------------------------------
# Secret used to sign preview tokens for unpublished content.
PREVIEW_SECRET=""
